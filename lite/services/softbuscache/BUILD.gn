import("//build/ohos.gni")
import("//foundation/distributedhardware/device_manager/device_manager.gni")

ohos_shared_library("dmdevicecache") {
    if (defined(ohos_lite)) {
      output_extension = "so"
    }
    if (!device_manager_capability) {
      install_enable = false
    } else {
      if (!defined(ohos_lite)) {
        sanitize = {
          boundary_sanitize = true
          cfi = true
          cfi_cross_dso = true
          debug = false
          integer_overflow = true
          ubsan = true
        }
      }

      cflags = [
        "-Werror",
        "-fPIC",
        "-fstack-protector-strong",
        "-std=c99",
      ]

      ldflags = [
        "-Wl,-z,relro",
        "-Wl,-z,now",
      ]

      include_dirs = [
        "include",
        "${lite_common_path}/include",
        "${lite_utils_path}/include/crypto",
        "${lite_json_path}/include",
      ]

      sources = [ "src/dm_softbus_cache.c" ]

      defines = [
        "HI_LOG_ENABLE",
        "DH_LOG_TAG=\"dmdevcache\"",
        "LOG_DOMAIN=0xD004113",
      ]

      deps = [
        "${lite_interfaces_path}:devicemanagersdk",
        "${lite_json_path}:devicemanagerjson",
        "${lite_utils_path}:devicemanagerutils",
      ]

      if (defined(ohos_lite)) {
        include_dirs += [
          "${lite_interfaces_path}/include/ipc",
          "${lite_interfaces_path}/include/ipc",
          "${lite_interfaces_path}/include/notify",
          "${lite_common_path}/include/ipc",
          "${lite_common_path}/include/ipc/model",
          "${lite_common_path}/include/ipc",
          "${lite_common_path}/include/dfx",
          "${lite_common_path}/include/dfx",
          "${lite_utils_path}/include",
          "${lite_utils_path}/include/jsonstr_handle",
          "${lite_utils_path}/include/kvadapter",
          "${lite_utils_path}/include/timer",
        ]
        deps += [ "//foundation/distributedhardware/device_manager/lite:dm_lite_external_deps" ]
      } else {
        external_deps = [
          "bounds_checking_function:libsec_shared",
          "cJSON:cjson",
          "dsoftbus:softbus_client",
          "hilog:libhilog",
        ]
      }

      subsystem_name = "distributedhardware"

      part_name = "device_manager"
    }
  }
